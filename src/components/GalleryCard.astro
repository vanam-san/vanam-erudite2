---
import { formatShortDate } from "@/lib/utils"
import type { CollectionEntry } from "astro:content"

type Props = { gallery: CollectionEntry<"gallery">; index?: number }

const { gallery, index = 0 } = Astro.props
const { title, description, date, photos, tags } = gallery.data
const photoCount = photos.length
---

<li class:list={["animate-in", `animate-in-delay-${Math.min(index + 1, 8)}`]}>
  <time datetime={date.toISOString()}>{formatShortDate(date)}</time>
  <a href={`/gallery/${gallery.id}`}>{title}</a>
  {tags && tags.length > 0 && (
    <entry-tags>{tags.map(t => t.toLowerCase()).join(" · ")}</entry-tags>
  )}
  <entry-meta>{photoCount} photo{photoCount === 1 ? "" : "s"}</entry-meta>
  {description && <entry-desc>{description}</entry-desc>}
</li>

<style>
  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    row-gap: var(--space-3xs);
    column-gap: var(--space-s);
    padding-block: var(--space-2xs);
    padding-inline-start: var(--space-xs);
    border-bottom: 1px solid color-mix(in oklab, var(--border) 55%, transparent);
    position: relative;

    &::before {
      content: "";
      position: absolute;
      left: 0;
      top: var(--space-2xs);
      bottom: var(--space-2xs);
      width: 2px;
      background: var(--primary);
      border-radius: 1px;
      opacity: 0;
      transform: scaleY(0);
      transition:
        opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:hover::before {
      opacity: 1;
      transform: scaleY(1);
    }

    &:last-child {
      border-bottom: none;
    }
  }

  time {
    grid-row: 1;
    grid-column: 1;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  a {
    grid-row: 1;
    grid-column: 2;
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    color: inherit;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration-color: transparent;
    text-underline-offset: 3px;

    &:hover {
      color: var(--primary);
      text-decoration-color: color-mix(
        in oklab,
        var(--primary) 40%,
        transparent
      );
    }
  }

  entry-tags {
    grid-row: 2;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    color: var(--muted-foreground);
  }

  entry-meta {
    grid-row: 3;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }

  entry-desc {
    grid-row: 4;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    line-clamp: 1;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (width < 40rem) {
    li {
      grid-template-columns: 4rem 1fr;
    }
  }
</style>
