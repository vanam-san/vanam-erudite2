---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { gallery: CollectionEntry<"gallery"> }

const { gallery } = Astro.props
---

<li>
  <a href={`/gallery/${gallery.id}`}>
    <gallery-card-image>
      <Image
        src={gallery.data.cover}
        alt={gallery.data.title}
        width={640}
        height={336}
        loading="lazy"
      />
    </gallery-card-image>
    <gallery-card-info>
      <gallery-card-title>{gallery.data.title}</gallery-card-title>
      <gallery-card-desc>{gallery.data.description}</gallery-card-desc>
      <gallery-card-count>
        {gallery.data.photos.length}
        photo{gallery.data.photos.length === 1 ? "" : "s"}
      </gallery-card-count>
    </gallery-card-info>
  </a>
</li>

<style>
  li {
    list-style: none;
  }

  a {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--muted) 30%, transparent);
    text-decoration-line: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      background-color: color-mix(in oklab, var(--muted) 60%, transparent);
      box-shadow: 0 2px 16px color-mix(in oklab, var(--primary) 6%, transparent);
      transform: translateY(-1px);
    }
  }

  gallery-card-image {
    display: block;
    overflow: hidden;

    :global(img) {
      display: block;
      width: 100%;
      height: 12rem;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
  }

  a:hover gallery-card-image :global(img) {
    transform: scale(1.03);
  }

  gallery-card-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s);
  }

  gallery-card-title {
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    line-height: calc(var(--leading-offset) + 1em);
  }

  gallery-card-desc {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    line-clamp: 2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  gallery-card-count {
    font-size: 0.625rem;
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }
</style>
