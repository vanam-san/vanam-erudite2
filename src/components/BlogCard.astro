---
import { formatShortDate, getWordCount, getReadingTime } from "@/lib/utils"
import { type CollectionEntry } from "astro:content"

type Props = { post: CollectionEntry<"blog"> }

const { post } = Astro.props
const wordCount = getWordCount(post.body ?? "")
const readingTime = getReadingTime(wordCount)
const formattedWordCount =
  wordCount >= 1000 ? `${(wordCount / 1000).toFixed(1)}k` : String(wordCount)
---

<li>
  <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
  <a href={`/blog/${post.id}`}>{post.data.title}</a>
  {post.data.tags && post.data.tags.length > 0 && (
    <entry-tags>{post.data.tags.join(" · ")}</entry-tags>
  )}
  <entry-meta>{formattedWordCount} words · {readingTime} min read</entry-meta>
  {post.data.description && <entry-desc>{post.data.description}</entry-desc>}
</li>

<style>
  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    row-gap: var(--space-3xs);
    column-gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-bottom: 1px solid color-mix(in oklab, var(--border) 55%, transparent);

    &:last-child {
      border-bottom: none;
    }
  }

  time {
    grid-row: 1;
    grid-column: 1;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  a {
    grid-row: 1;
    grid-column: 2;
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    color: inherit;
    transition: color 0.15s ease;

    &:hover {
      color: var(--primary);
    }
  }

  entry-tags {
    grid-row: 2;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    color: var(--muted-foreground);
  }

  entry-meta {
    grid-row: 3;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }

  entry-desc {
    grid-row: 4;
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    line-clamp: 1;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (width < 40rem) {
    li {
      grid-template-columns: 4rem 1fr;
    }
  }
</style>
