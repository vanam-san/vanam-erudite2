---
import GalleryCard from "@/components/GalleryCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getGalleries, getGalleriesByYear } from "@/lib/content"

const galleries = await getGalleries()
const galleriesByYear = getGalleriesByYear(galleries)
---

<Layout>
  <MetaPage slot="head" title="Gallery" />
  <div class="page-header animate-in">
    <h1 class="page-title">Gallery</h1>
    <p class="page-desc">A collection of photography and visual work, organized by year.</p>
  </div>
  <div class="year-groups">
    {[...galleriesByYear.entries()].map(([year, yearGalleries]) => (
      <section class="year-group animate-in">
        <h2>{year}</h2>
        <ul class="gallery-list">
          {yearGalleries.map((gallery, i) => <GalleryCard gallery={gallery} index={i} />)}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    margin-block-end: var(--space-m);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .page-desc {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    margin-block-start: var(--space-2xs);
  }

  .gallery-list {
    display: flex;
    flex-direction: column;
  }

  .year-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .year-group {
    h2 {
      font-size: var(--step--1);
      font-family: var(--font-mono);
      font-weight: var(--font-weight-medium);
      color: var(--muted-foreground);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-block-end: var(--space-2xs);
    }
  }
</style>
