---
import MetaPage from "@/components/MetaPage.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import Layout from "@/layouts/Layout.astro"
import CurrencyTracker from "@/components/bento/CurrencyTracker.astro"
import BouncingSquare from "@/components/bento/BouncingSquare.astro"
import CRTClock from "@/components/bento/CRTClock.astro"
import MatrixRain from "@/components/bento/MatrixRain.astro"
import Starfield from "@/components/bento/Starfield.astro"
---

<Layout>
  <MetaPage slot="head" title="Playground" />
  <ScrollToTop floating />

  <div class="page-header">
    <h1 class="page-title">Playground</h1>
    <p class="page-subtitle">
      Live currency rates, flight tracking, and a few animated widgets
    </p>
  </div>

  <div class="bento-grid bento-grid-playground">
    <Starfield />
    <CRTClock />
    <MatrixRain />
    <BouncingSquare />
    <CurrencyTracker />
  </div>
</Layout>

<style>
  .page-header {
    margin-block-end: var(--space-m);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    margin-block-start: var(--space-3xs);
  }
</style>
